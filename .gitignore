# Build outputs. dist/ is regenerated by `python build_resume.py`, but it is
# ALSO what gets published to the gh-pages branch (see DEPLOY.md), so it is
# committed on purpose — only the intermediate is ignored.
dist/resume.html

# Scratch screenshots written by tests/measure_heights.py, and any other
# underscore-prefixed scratch file (the convention makes them easy to spot and
# impossible to mistake for pipeline code).
_*.py
_*.png

# Machine-local tool permissions, not project configuration.
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
